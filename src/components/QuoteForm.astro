<form class="quote-form" id="quote-form">
  <aside class="form-estimate" id="form-estimate" aria-live="polite" hidden>
    <p>Ваш расчёт</p>
    <strong id="form-estimate-price"></strong>
    <span id="form-estimate-summary"></span>
  </aside>

  <div class="form-step form-contact-step">
    <div class="form-step-heading">
      <span>01</span>
      <h3>Как с вами связаться?</h3>
    </div>

    <div class="field">
      <label for="name">Как к вам обращаться</label>
      <input id="name" name="name" type="text" autocomplete="name" maxlength="100" aria-describedby="name-error" required />
      <p class="field-error" id="name-error" hidden></p>
    </div>

    <div class="field">
      <label for="contact">Телефон или Telegram</label>
      <input id="contact" name="contact" type="text" autocomplete="tel" inputmode="tel" maxlength="160" placeholder="+7 … или @username" aria-describedby="contact-error" required />
      <p class="field-error" id="contact-error" hidden></p>
    </div>

    <div class="field field-full">
      <label for="comment">Комментарий <span class="field-optional">Необязательно</span></label>
      <textarea id="comment" name="comment" rows="4" maxlength="1000" placeholder="Расскажите о важных деталях объекта"></textarea>
    </div>

    <div class="form-honeypot" aria-hidden="true">
      <label for="website">Сайт</label>
      <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
  </div>

  <div class="form-submit">
    <p>Адрес на этом этапе не нужен. Итоговую стоимость согласуем после уточнения деталей.</p>
    <button class="button" type="submit">Отправить запрос</button>
  </div>

  <noscript>Для отправки заявки включите JavaScript.</noscript>
  <p class="form-status" id="form-status" role="status" aria-live="polite" hidden></p>
</form>

<script>
  import { estimateChangeEvent, getCurrentEstimate } from "../lib/estimate-state";
  import { createLeadPayload, type LeadEstimate } from "../lib/lead";

  const form = document.querySelector<HTMLFormElement>("#quote-form");
  const nameInput = document.querySelector<HTMLInputElement>("#name");
  const contactInput = document.querySelector<HTMLInputElement>("#contact");
  const commentInput = document.querySelector<HTMLTextAreaElement>("#comment");
  const websiteInput = document.querySelector<HTMLInputElement>("#website");
  const nameError = document.querySelector<HTMLParagraphElement>("#name-error");
  const contactError = document.querySelector<HTMLParagraphElement>("#contact-error");
  const estimatePanel = document.querySelector<HTMLElement>("#form-estimate");
  const estimatePrice = document.querySelector<HTMLElement>("#form-estimate-price");
  const estimateSummary = document.querySelector<HTMLElement>("#form-estimate-summary");
  const status = document.querySelector<HTMLParagraphElement>("#form-status");
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submitLabel = submitButton?.textContent ?? "Отправить запрос";
  let isSubmitting = false;

  const propertyLabels = { apartment: "Квартира", house: "Дом", office: "Офис" } as const;
  const cleaningLabels = { regular: "Стандартная", general: "Генеральная", "post-renovation": "После ремонта" } as const;

  function setFieldError(input: HTMLInputElement, error: HTMLParagraphElement | null, message: string): boolean {
    input.setCustomValidity(message);
    input.setAttribute("aria-invalid", String(Boolean(message)));
    if (error) {
      error.textContent = message;
      error.hidden = !message;
    }
    return !message;
  }

  function validateForm(): boolean {
    if (!nameInput || !contactInput) return false;

    const nameIsValid = setFieldError(
      nameInput,
      nameError,
      nameInput.value.trim() ? "" : "Укажите, как к вам обращаться.",
    );
    const contactIsValid = setFieldError(
      contactInput,
      contactError,
      contactInput.value.trim() ? "" : "Укажите телефон или Telegram для связи.",
    );

    return nameIsValid && contactIsValid;
  }

  function renderEstimate(estimate: LeadEstimate | undefined): void {
    if (!estimatePanel || !estimatePrice || !estimateSummary) return;

    if (!estimate) {
      estimatePrice.textContent = "";
      estimateSummary.textContent = "";
      estimatePanel.hidden = true;
      return;
    }

    estimatePrice.textContent = `≈ ${new Intl.NumberFormat("ru-RU").format(estimate.price)} ₽`;
    estimateSummary.textContent = `${estimate.area} м² · ${cleaningLabels[estimate.cleaningType]} · ${propertyLabels[estimate.propertyType]}`;
    estimatePanel.hidden = false;
  }

  nameInput?.addEventListener("input", validateForm);
  contactInput?.addEventListener("input", validateForm);
  document.addEventListener(estimateChangeEvent, (event) => {
    renderEstimate((event as CustomEvent<LeadEstimate | undefined>).detail);
  });
  renderEstimate(getCurrentEstimate());

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (isSubmitting) return;

    if (!validateForm()) {
      form.querySelector<HTMLInputElement>("[aria-invalid=\"true\"]")?.focus();
      return;
    }

    const payload = createLeadPayload({
      name: nameInput?.value ?? "",
      contact: contactInput?.value ?? "",
      comment: commentInput?.value ?? "",
      estimate: getCurrentEstimate(),
    });

    isSubmitting = true;
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "Отправляем…";
    }
    if (status) {
      status.hidden = false;
      status.textContent = "Отправляем заявку…";
    }

    try {
      const response = await fetch("/api/lead", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ ...payload, website: websiteInput?.value ?? "" }),
      });

      const result: unknown = await response.json();
      const delivered = typeof result === "object" && result !== null && "ok" in result && result.ok === true;
      if (!response.ok || !delivered) throw new Error("Lead delivery failed");
      if (status) status.textContent = "Заявка отправлена. Свяжемся с вами, чтобы уточнить детали.";
    } catch {
      if (status) status.textContent = "Не удалось отправить заявку. Попробуйте ещё раз.";
    } finally {
      isSubmitting = false;
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = submitLabel;
      }
    }
  });
</script>
