---
import { previewPhotos } from "../data/archive";
---

<div class="archive-gallery" data-preview-gallery aria-label="Примеры уборки">
  <div class="archive-slots" id="preview-slides">
    {previewPhotos.map((photo, index) => (
      <figure class:list={["archive-slot", { "is-active": index === 0 }]}>
        <div class="archive-media">
          <img
            src={photo.src}
            width={photo.width}
            height={photo.height}
            loading="lazy"
            decoding="async"
            alt={photo.alt}
          />
        </div>
        <figcaption>
          <span>{photo.scene} · {photo.phase}</span>
        </figcaption>
      </figure>
    ))}
  </div>

  <div class="archive-controls" data-gallery-controls hidden>
    <button class="archive-arrow" type="button" aria-label="Предыдущее изображение" aria-controls="preview-slides" data-gallery-previous>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m14 5-7 7 7 7M7 12h14" /></svg>
    </button>
    <div class="archive-position">
      <span class="archive-counter" data-gallery-counter aria-hidden="true">1 / {previewPhotos.length}</span>
      <span class="archive-announcement" data-gallery-announcement aria-live="polite" aria-atomic="true">Изображение 1 из {previewPhotos.length}: {previewPhotos[0].scene} · {previewPhotos[0].phase}</span>
      <div class="archive-progress" aria-hidden="true">
        {previewPhotos.map((_, index) => <span class:list={{ "is-active": index === 0 }} />)}
      </div>
    </div>
    <button class="archive-arrow" type="button" aria-label="Следующее изображение" aria-controls="preview-slides" data-gallery-next>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m10 5 7 7-7 7M17 12H3" /></svg>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-preview-gallery]").forEach((gallery) => {
    const slides = [...gallery.querySelectorAll<HTMLElement>(".archive-slot")];
    const progress = [...gallery.querySelectorAll<HTMLElement>(".archive-progress span")];
    const controls = gallery.querySelector<HTMLElement>("[data-gallery-controls]");
    const counter = gallery.querySelector<HTMLElement>("[data-gallery-counter]");
    const announcement = gallery.querySelector<HTMLElement>("[data-gallery-announcement]");
    const previous = gallery.querySelector<HTMLButtonElement>("[data-gallery-previous]");
    const next = gallery.querySelector<HTMLButtonElement>("[data-gallery-next]");
    if (!slides.length || !controls || !counter || !announcement || !previous || !next) return;

    let active = 0;
    gallery.dataset.enhanced = "true";
    controls.hidden = false;

    const show = (index: number) => {
      active = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => slide.classList.toggle("is-active", slideIndex === active));
      progress.forEach((item, itemIndex) => item.classList.toggle("is-active", itemIndex === active));
      counter.textContent = `${active + 1} / ${slides.length}`;
      const caption = slides[active].querySelector("figcaption span")?.textContent?.trim() ?? "";
      announcement.textContent = `Изображение ${active + 1} из ${slides.length}: ${caption}`;
    };

    previous.addEventListener("click", () => show(active - 1));
    next.addEventListener("click", () => show(active + 1));
    gallery.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") { event.preventDefault(); show(active - 1); }
      if (event.key === "ArrowRight") { event.preventDefault(); show(active + 1); }
    });
  });
</script>
